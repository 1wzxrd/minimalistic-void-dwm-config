*foreground:        #d9e8f9
*background:        #0b182e
*.foreground:       #d9e8f9
*.background:       #0b182e
emacs*foreground:   #d9e8f9
emacs*background:   #0b182e
URxvt*foreground:   #d9e8f9
XTerm*foreground:   #d9e8f9
UXTerm*foreground:  #d9e8f9
URxvt*background:   #0b182eff
XTerm*background:   #0b182e
UXTerm*background:  #0b182e
URxvt*cursorColor:  #d9e8f9
XTerm*cursorColor:  #d9e8f9
UXTerm*cursorColor: #d9e8f9
URxvt*borderColor:  #0b182eff
! Colors 0-15.
*.color0: #0b182e
*color0:  #0b182e
*.color1: #61779a
*color1:  #61779a
*.color2: #6e87b0
*color2:  #6e87b0
*.color3: #6f91bc
*color3:  #6f91bc
*.color4: #8b8da3
*color4:  #8b8da3
*.color5: #96b7d8
*color5:  #96b7d8
*.color6: #81a5ce
*color6:  #81a5ce
*.color7: #d9e8f9
*color7:  #d9e8f9
*.color8: #405c82
*color8:  #405c82
*.color9: #61779a
*color9:  #61779a
*.color10: #6e87b0
*color10:  #6e87b0
*.color11: #6f91bc
*color11:  #6f91bc
*.color12: #8b8da3
*color12:  #8b8da3
*.color13: #96b7d8
*color13:  #96b7d8
*.color14: #81a5ce
*color14:  #81a5ce
*.color15: #d9e8f9
*color15:  #d9e8f9
! Black color that will not be affected by bold highlighting.
*.color66: #0b182e
*color66:  #0b182e
! Xclock colors.
XClock*foreground: #d9e8f9
XClock*background: #0b182e
XClock*majorColor:  rgba:d9/e8/f9/ff
XClock*minorColor:  rgba:d9/e8/f9/ff
XClock*hourColor:   rgba:d9/e8/f9/ff
XClock*minuteColor: rgba:d9/e8/f9/ff
XClock*secondColor: rgba:d9/e8/f9/ff
! Set depth to make transparency work.
URxvt*depth: 32
